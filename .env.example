# Django Core Settings
DEBUG=False
SECRET_KEY=your-production-secret-key-here
ALLOWED_HOSTS=trizenai-photo-sharing.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://trizenai-photo-sharing.onrender.com,http://localhost:8000,http://127.0.0.1:8000

# Database Configuration (Supabase PostgreSQL)
DATABASE_ENGINE=postgresql
DATABASE_URL=postgresql://postgres.user:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase Storage & Server-Side API Configuration (Private - Never expose service-role key to client)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_STORAGE_BUCKET=event-photos
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Public / Client Keys
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_ANON_KEY=your-supabase-publishable-key

# Email / SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=TrizenAI Studio <your-email@gmail.com>